<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputName>Vigilo</OutputName>
    <PublishDirectory Condition="'$(PublishDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\publish\win-x64</PublishDirectory>
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <DefineConstants>Version=$(Version);PublishDirectory=$(PublishDirectory)</DefineConstants>
    <!-- WiX's file harvester uses files as component key paths. Windows
         Installer's ICE38/64 rules require an HKCU key path for every file
         component below LocalAppData, which is impractical for a framework-
         self-contained payload. The bundle is strictly per-user and the two
         registry-owning components use explicit HKCU key paths. -->
    <SuppressIces>ICE38;ICE60;ICE64;ICE91</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
